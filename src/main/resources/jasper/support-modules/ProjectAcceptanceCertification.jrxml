				</textElement>
				<textFieldExpression><![CDATA["This is to certify that the above stated project has been accepted by the end-user, Negros Oriental Electric Cooperative I, Inc. (NORECO I) as of "+new SimpleDateFormat("MMMM dd, yyyy").format($P{CERTIFICATION_DATE})+"."]]></textFieldExpression>
