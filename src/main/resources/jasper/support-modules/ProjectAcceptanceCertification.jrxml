				<textElement verticalAlignment="Middle">
					<font fontName="SansSerif" size="12"/>
				</textElement>
				<textFieldExpression><![CDATA["Based on the Acceptance Report of the Inspectorate Team dated "+new SimpleDateFormat("MMMM dd, yyyy").format($P{ACCEPTANCE_REPORT_DATE})+", the project is free from failures and defects which are traceable to poor workmanship, use of poor quality materials and non-compliance with Plans and Specification of the Contract."]]></textFieldExpression>
