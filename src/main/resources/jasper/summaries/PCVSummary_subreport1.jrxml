	<parameter name="BATCH_ID" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	hasSL,
	pct.code,
	FK_accountNo,
	sa.accountCode,
	payee,
	expenseAmount,
	sum(expenseAmount) as amount,
	voucherDate,
	GROUP_CONCAT(COALESCE(pctd.remarks,'') SEPARATOR ', ') as nature_of_payment,
	a.title
		from PettyCashTrans pct
		JOIN PettyCashTransDetail pctd ON pct.id = pctd.id
		JOIN segmentaccount sa ON FK_expenseId = sa.id
		join account a on sa.id = a.id
			WHERE FK_pettyCashBatchId = $P{BATCH_ID}
			and FK_documentStatusId <> 26
				GROUP BY sa.accountCode, FK_accountNo
				order by sa.accountCode, pct.id;]]>
	</queryString>
