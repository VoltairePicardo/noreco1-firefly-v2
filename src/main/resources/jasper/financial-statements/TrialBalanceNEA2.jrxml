	</variable>
	<variable name="totalRevenue_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalRevenue}]]></variableExpression>
	</variable>
	<variable name="totalCostAndExp_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalCostAndExp}]]></variableExpression>
	</variable>
	<variable name="variance" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{totalAsset_1}.subtract($V{liaEqui})]]></variableExpression>
	</variable>
	<variable name="liaEqui" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{totalLiabAndEqui_1}.add($V{totalRevenue_1}.subtract($V{totalCostAndExp_1}))]]></variableExpression>
	</variable>
	<variable name="begDebitTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{begDebit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="begCreditTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{begCredit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="transDebitTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{transDebit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="transCreditTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{transCredit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="endingDebitTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{endingDebit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="endingCreditTotal" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false ? $F{endingCredit} : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="grandTotalDebit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{begDebitTotal}.add($V{transDebitTotal}).add($V{endingDebitTotal})]]></variableExpression>
	</variable>
	<variable name="grandTotalCredit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{begCreditTotal}.add($V{transCreditTotal}).add($V{endingCreditTotal})]]></variableExpression>
	</variable>
	<variable name="totalCurrentRevenue" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false && $F{accountTypeId} == 4 ? $F{transCredit}.subtract($F{transDebit}) : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="totalCurrentExpenses" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false && $F{accountTypeId} == 5 ? $F{transDebit}.subtract($F{transCredit}) : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="totalLiabilities" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false && ($F{accountTypeId} == 2 || $F{accountTypeId} == 3) ? $F{endingCredit}.subtract($F{endingDebit}) : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="totalLiabilitiesCredit" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{begCreditTotal}.add($V{transCreditTotal}).add($V{endingCreditTotal})]]></variableExpression>
	</variable>
	<variable name="totalBegRevenue" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false && $F{accountTypeId} == 4 ? $F{begCredit}.subtract($F{begDebit}) : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="totalBegExpenses" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{isHeader} != null && $F{isHeader} == false && $F{accountTypeId} == 5 ? $F{begDebit}.subtract($F{begCredit}) : new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="totalTransRevenue_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalTransRevenue}]]></variableExpression>
	</variable>
	<variable name="totalTransCostAndExp_1" class="java.math.BigDecimal" calculation="Sum">
