	<variable name="totalAsset_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalAsset}]]></variableExpression>
	</variable>
	<variable name="totalLiabAndEqui_1" class="java.math.BigDecimal" calculation="Sum">
