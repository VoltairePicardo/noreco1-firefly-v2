	</variable>
	<variable name="totalBegRevenue_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalBegRevenue}]]></variableExpression>
	</variable>
	<variable name="totalBegCostAndExp_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{totalBegCostAndExp}]]></variableExpression>
	</variable>
	<variable name="netIncomeCurrMonth" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{totalTransRevenue_1}.subtract($V{totalTransCostAndExp_1})]]></variableExpression>
	</variable>
	<variable name="netIncomePrevMonth" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{totalBegRevenue_1}.subtract($V{totalBegCostAndExp_1})]]></variableExpression>
	</variable>
