	<queryString>
		<![CDATA[SELECT a.acct_id,a.title,a.code,1 as included
                 FROM   accounts AS a
                        INNER JOIN registers_cols_settings AS r
                                ON r.`acct_id` = a.`acct_id`
                 WHERE  r.`report_id` = $P{report_id}]]>
	</queryString>
